# open-moderation-lexicon server configuration.
#
# Copy to .env for local development (docker-compose reads it automatically).
# Every value below is a default; the server runs with none of them set.
#
# .env is git-ignored. Never commit a file containing a real API_TOKEN.

# --- Network -----------------------------------------------------------------

HOST=0.0.0.0
PORT=3000

# Trust X-Forwarded-For for client identification. Only enable behind a proxy you
# control: otherwise a client can spoof the header and defeat the rate limiter.
TRUST_PROXY=false

# Request timeout in milliseconds.
REQUEST_TIMEOUT_MS=30000

# --- Limits ------------------------------------------------------------------

# Maximum accepted text length, in UTF-16 code units.
MAX_TEXT_LENGTH=20000

# Maximum request body size in bytes. Applied before JSON parsing.
MAX_BODY_BYTES=1048576

# Maximum number of items in a POST /v1/moderate/batch request.
BATCH_MAX_ITEMS=100

# --- Matching ----------------------------------------------------------------

# Mode used when a request does not specify one: exact | normalized | fuzzy.
# fuzzy increases false positives; leave it opt-in per request unless you know
# you want it everywhere.
DEFAULT_MODE=normalized

# Modes compiled at startup, comma separated. Uncompiled modes are built on first
# use, which makes that one request slower.
PRECOMPILE_MODES=normalized

# --- Lexicon -----------------------------------------------------------------

# Categories to load:
#   all  - only categories marked defaultEnabled (17,689 terms). Recommended.
#   *    - every category (51,336 terms), including broad lists that contain
#          ordinary words. Expect many more false positives.
#   a comma separated list of category ids - exactly those, regardless of the flag.
# GET /v1/metadata lists the ids and which ones are enabled by default.
LEXICON_CATEGORIES=all

# Drop terms shorter than this many code points. 1 loads single-character terms,
# which match constantly; 2 is the safe default.
LEXICON_MIN_TERM_LENGTH=2

# Load terms flagged for human review (single characters, digit-only terms,
# HTML-like fragments, very long terms). Listed in data/reports/review-needed.json.
LEXICON_INCLUDE_NEEDS_REVIEW=false

# --- Policy ------------------------------------------------------------------
#
# decision is a policy output, not a legal conclusion. Nothing matched -> allow;
# a match -> review; a match at a blocking severity or category -> block.

# Severities that produce decision=block. Comma separated: low, medium, high.
POLICY_BLOCK_SEVERITIES=high

# Categories that always produce block, regardless of term severity.
# POLICY_BLOCK_CATEGORIES=weapons-explosives,violence-terrorism

# Categories downgraded to allow even when they match.
# POLICY_ALLOW_CATEGORIES=advertising

# Default character used for masking. Exactly one Unicode code point.
MASK_CHAR=*

# --- Security ----------------------------------------------------------------

# When set, every /v1/* request needs "Authorization: Bearer <token>".
# /health stays open so orchestrators can probe it. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# API_TOKEN=

# CORS. Unset disables the plugin entirely (no CORS headers at all).
#   *                              allow any origin
#   https://a.example,https://b.example   allow a specific list
# CORS_ORIGIN=

# Rate limit per client per window.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Serve Swagger UI at /docs and the OpenAPI document at /docs/json.
ENABLE_DOCS=true

# --- Logging -----------------------------------------------------------------

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# DANGER: logs the full submitted text. Off by default, and off is the right
# setting for production. With it off, logs contain only a request id, duration,
# text length, hit count and category names.
LOG_TEXT=false
